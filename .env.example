# =========================================================
# IndiaHotelReviews (IHR) — Environment Variables & API Keys
# =========================================================

# 1. Google Gemini AI API Key (For Live AI Chatbot & Review Synthesis)
# Get a free API key at: https://aistudio.google.com/app/apikey
# Optional: The app includes a built-in offline editorial knowledge engine if not provided.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Map Service API Key (Optional)
# Current implementation uses Leaflet + OpenStreetMap (no key needed).
# If switching to Mapbox or Google Maps:
VITE_MAPBOX_TOKEN=your_mapbox_token_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 3. Cloud Storage / Image Uploads (Optional for Production Photo Uploads)
# E.g., Cloudinary or ImageKit or AWS S3
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# 4. Backend Database / Auth (Optional for Production Backend)
# E.g., Supabase or Firebase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
